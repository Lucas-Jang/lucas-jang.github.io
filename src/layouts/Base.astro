---
import '../styles/global.css';
import '../styles/brand.css';
const { title = 'LucasJang', description = '사진과 기록을 모은 개인 저널.' } = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#f6f5f2"><link rel="icon" href="/images/favicon/favicon-32x32.png"><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:image" content={new URL('/images/lucasjang-logo.png', Astro.site)}><title>{title}</title></head><body><header><a class="wordmark" href="/"><img src="/images/lucasjang-logo.png" alt="LucasJang" width="2163" height="727"></a><nav aria-label="주요 메뉴"><a href="/">전체</a><a href="/?category=DEV">개발</a><a href="/?category=ENGLISH">영어</a><a href="/?category=BJJ">주짓수</a><a href="/?category=DIVE">프리다이빙</a><a href="/?category=DISTILL">증류</a><a href="/?category=LIFE">일상</a><a href="/about/">소개</a></nav><a class="menu" href="/archive/">글 목록</a></header><main><slot /></main><footer><span>© {new Date().getFullYear()} LucasJang</span><a href="/archive/">아카이브</a><a href="/search/">검색</a><a href="https://github.com/Lucas-Jang">GITHUB</a></footer></body></html>
