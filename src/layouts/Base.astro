---
import '../styles/global.css';
import '../styles/brand.css';

const {
  title = 'LucasJang',
  description = '사진과 기록을 모은 개인 저널.',
  bodyClass = '',
  bodyDataCategory,
} = Astro.props;

const categories = [
  ['DEV', '개발', '/?category=DEV'],
  ['ENGLISH', '영어', '/?category=ENGLISH'],
  ['BJJ', '주짓수', '/?category=BJJ'],
  ['DIVE', '프리다이빙', '/?category=DIVE'],
  ['DISTILL', '증류', '/?category=DISTILL'],
  ['LIFE', '일상', '/?category=LIFE'],
];

const gaMeasurementId = import.meta.env.PROD
  && /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '')
  ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID
  : undefined;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#66879b" />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/lucasjang-logo.png', Astro.site)} />
    <title>{title}</title>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body class={bodyClass} data-category={bodyDataCategory}>
    {Astro.url.pathname === '/' && <script is:inline>
      // Reserve the home frame before the illustration modules load.
      const carCategory = new URLSearchParams(location.search).get('category');
      if (!carCategory || carCategory === 'ALL') {
        document.body.classList.add('car-home');
        window.addEventListener('load', () => {
          if (!document.getElementById('lucas-roaming-car')) document.body.classList.remove('car-home');
        }, { once: true });
      }
    </script>}
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <header>
      <a class="home-link" data-nav-home href="/" aria-label="LucasJang 홈으로 이동">LucasJang</a>
      <nav class="site-nav" aria-label="카테고리">
        {categories.map(([id, label, href]) => <a data-nav-category={id} href={href}>{label}</a>)}
        <a class="site-nav-about" data-nav-about href="/about/">소개</a>
      </nav>
      <details class="menu">
        <summary aria-label="메뉴 열기" aria-controls="mobile-menu">메뉴</summary>
        <div class="menu-panel" id="mobile-menu">
          <a class="menu-home" data-nav-home href="/">홈으로 돌아가기<span aria-hidden="true">↖</span></a>
          <nav aria-label="카테고리 탐색">
            <p>카테고리</p>
            {categories.map(([id, label, href]) => <a data-nav-category={id} href={href}>{label}</a>)}
          </nav>
          <a class="menu-about" data-nav-about href="/about/">소개</a>
          <div class="menu-utilities" aria-label="글 탐색 도구">
            <p>글 탐색</p>
            <a data-nav-utility="archive" href="/archive/"><span>글 목록</span></a>
            <a data-nav-utility="search" href="/search/"><span>검색</span></a>
          </div>
          <div class="home-menu-meta">
            <span>© {new Date().getFullYear()} LucasJang</span>
            <p class="site-stats" aria-label="페이지별 방문 합계. 오늘은 UTC 기준으로 한국 시간 오전 9시에 바뀌며 집계가 지연될 수 있습니다." title="순사용자 수가 아닌 페이지별 방문 합계입니다. 오늘은 UTC 기준(한국 시간 오전 9시 초기화)이며, 공개 카운터와 저장값은 원본 캐시·배포 지연으로 수시간 이상 늦을 수 있습니다.">
              <span>누적 방문 <span data-stat="visitors">—</span></span><span aria-hidden="true">·</span>
              <span>오늘(UTC) <span data-stat="today">—</span></span>
              <span aria-hidden="true">지연 집계</span>
            </p>
          </div>
        </div>
      </details>
    </header>
    <main id="main-content" tabindex="-1" data-pagefind-body><slot /></main>
    <footer>
      <div class="footer-primary">
        <span>© {new Date().getFullYear()} LucasJang</span>
        <a href="/archive/">아카이브</a>
        <a href="/search/">검색</a>
        <a href="https://github.com/Lucas-Jang">GITHUB</a>
      </div>
      <p class="site-stats" aria-label="페이지별 방문 합계. 오늘은 UTC 기준으로 한국 시간 오전 9시에 바뀌며 집계가 지연될 수 있습니다." title="순사용자 수가 아닌 페이지별 방문 합계입니다. 오늘은 UTC 기준(한국 시간 오전 9시 초기화)이며, 공개 카운터와 저장값은 원본 캐시·배포 지연으로 수시간 이상 늦을 수 있습니다.">
        <span>누적 방문 <span data-stat="visitors">—</span></span>
        <span aria-hidden="true">·</span>
        <span>오늘(UTC) <span data-stat="today">—</span></span>
        <span aria-hidden="true">지연 집계</span>
      </p>
    </footer>
    <script src="/scripts/site-stats.js?v=20261018-1" defer></script>
    {Astro.url.pathname === '/' && <script is:inline type="module" src="/scripts/roaming-car.js?v=20261017-16"></script>}
    <script is:inline>
      (() => {
        const currentCategory = new URLSearchParams(location.search).get('category');
        const isAbout = location.pathname.startsWith('/about/');
        const setCurrent = (link, isCurrent) => {
          if (isCurrent) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        };
        document.querySelectorAll('[data-nav-category]').forEach((link) => {
          const isCurrent = link.dataset.navCategory === currentCategory;
          setCurrent(link, isCurrent);
        });
        document.querySelectorAll('[data-nav-about]').forEach((link) => {
          setCurrent(link, isAbout);
        });
        document.querySelectorAll('[data-nav-utility]').forEach((link) => {
          setCurrent(link, location.pathname.startsWith(`/${link.dataset.navUtility}/`));
        });
        document.querySelectorAll('[data-nav-home]').forEach((link) => {
          setCurrent(link, location.pathname === '/' && (!currentCategory || currentCategory === 'ALL'));
        });
        const menu = document.querySelector('.menu');
        const summary = menu?.querySelector('summary');
        menu?.addEventListener('toggle', () => {
          const isOpen = menu.hasAttribute('open');
          summary?.setAttribute('aria-expanded', String(isOpen));
          summary?.setAttribute('aria-label', isOpen ? '메뉴 닫기' : '메뉴 열기');
        });
      })();
    </script>
  </body>
</html>
