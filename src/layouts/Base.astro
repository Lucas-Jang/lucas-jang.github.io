---
import '../styles/global.css';
const { title = 'WONJUN', description = 'A personal visual journal.' } = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#f6f5f2"><link rel="icon" href="/images/favicon/favicon-32x32.png"><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:image" content={new URL('/images/profile.jpg', Astro.site)}><title>{title}</title></head><body><header><a class="wordmark" href="/">WONJUN</a><nav aria-label="Primary"><a href="/">ALL</a><a href="/?category=DEV">DEV</a><a href="/?category=ENGLISH">ENGLISH</a><a href="/?category=BJJ">BJJ</a><a href="/?category=DIVE">DIVE</a><a href="/?category=DISTILL">DISTILL</a><a href="/?category=LIFE">LIFE</a><a href="/about/">ABOUT</a></nav><a class="menu" href="/archive/">MENU</a></header><main><slot /></main><footer><span>© {new Date().getFullYear()} WONJUN</span><a href="/archive/">ARCHIVE</a><a href="/search/">SEARCH</a><a href="https://github.com/Lucas-Jang">GITHUB</a></footer></body></html>
