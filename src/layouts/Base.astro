---
import '../styles/global.css';
import '../styles/brand.css';

const {
  title = 'LucasJang',
  description = '사진과 기록을 모은 개인 저널.',
  bodyClass = '',
  bodyDataCategory,
} = Astro.props;

const categories = [
  ['개발', '/?category=DEV'],
  ['영어', '/?category=ENGLISH'],
  ['주짓수', '/?category=BJJ'],
  ['프리다이빙', '/?category=DIVE'],
  ['증류', '/?category=DISTILL'],
  ['일상', '/?category=LIFE'],
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#66879b" />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/lucasjang-logo.png', Astro.site)} />
    <title>{title}</title>
  </head>
  <body class={bodyClass} data-category={bodyDataCategory}>
    <header>
      <nav class="site-nav" aria-label="카테고리">
        {categories.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="site-nav-about" href="/about/">소개</a>
      </nav>
      <details class="menu">
        <summary aria-label="메뉴 열기">메뉴</summary>
        <div class="menu-panel">
          <nav aria-label="카테고리 탐색">
            <p>카테고리</p>
            {categories.map(([label, href]) => <a href={href}>{label}</a>)}
          </nav>
          <a class="menu-about" href="/about/">소개<span>LucasJang에 대하여</span></a>
          <div class="menu-utilities" aria-label="글 탐색 도구">
            <p>글 탐색</p>
            <a href="/archive/"><span>글 목록</span><small>날짜별로 보기</small></a>
            <a href="/search/"><span>검색</span><small>제목과 본문에서 찾기</small></a>
          </div>
        </div>
      </details>
    </header>
    <main data-pagefind-body><slot /></main>
    <footer>
      <span>© {new Date().getFullYear()} LucasJang</span>
      <a href="/archive/">아카이브</a>
      <a href="/search/">검색</a>
      <a href="https://github.com/Lucas-Jang">GITHUB</a>
    </footer>
  </body>
</html>
