---
import Base from './Base.astro'; import { categoryLabel } from '../lib/posts';
import type { CollectionEntry } from 'astro:content';
const { post } = Astro.props as { post: CollectionEntry<'posts'> };
---
<Base title={`${post.data.title} — LucasJang`} description={post.data.description}><article class:list={['post', post.data.postType]}><header class="post-head"><p>{categoryLabel(post.data.category)} · {post.data.date.toLocaleDateString('ko-KR')}</p><h1>{post.data.title}</h1>{post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}</header>{post.data.cover && <img class="post-cover" src={post.data.cover} alt={post.data.coverAlt} width="1600" height="1067" loading="eager" />}{post.data.postType === 'gallery' && <div class="gallery-strip">{post.data.gallery.map((image: {src:string;alt:string;caption?:string}) => <figure><img src={image.src} alt={image.alt} width="1200" height="900" loading="lazy" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>}<div class="prose"><slot /></div></article></Base>
