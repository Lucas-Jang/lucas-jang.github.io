---
import { categoryLabel, formatDate } from '../lib/posts';
const { post, featured = false } = Astro.props;
---
<article class:list={['tile', { featured }]} data-category={post.data.category}><a href={`/posts/${post.id}/`}>{post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt} width="1600" height="1067" loading={featured ? 'eager' : 'lazy'} />}</a><div><p>{categoryLabel(post.data.category)} · {formatDate(post.data.date)}</p><h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2><p class="tile-description">{post.data.description}</p></div></article>
