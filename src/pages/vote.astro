---
import '../styles/vote.css';
const weekdays = ['일', '월', '화', '수', '목', '금', '토'];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#f6f1e8" />
    <meta name="description" content="진단 회식에 초대합니다. 안건은 회식, 진짜 이유는 보고 싶어서. 11월 6일까지 가능한 날을 알려 주세요." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://lucas-jang.github.io/vote/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://lucas-jang.github.io/vote/" />
    <meta property="og:title" content="진단 회식에 초대합니다" />
    <meta property="og:description" content="안건은 회식. 진짜 이유는, 보고 싶어서. 11월 6일까지 가능한 날짜를 알려 주세요." />
    <meta property="og:image" content="https://lucas-jang.github.io/vote/share-invitation-v1.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="안건은 회식. 진짜 이유는, 보고 싶어서. 봉투와 붉은 봉인 도장이 담긴 진단 회식 초대장." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="진단 회식에 초대합니다" />
    <meta name="twitter:description" content="11월 6일까지 가능한 날짜를 알려 주세요. 드레스 코드는 없고, 빈속이면 충분합니다." />
    <meta name="twitter:image" content="https://lucas-jang.github.io/vote/share-invitation-v1.png" />
    <meta name="twitter:image:alt" content="안건은 회식. 진짜 이유는, 보고 싶어서. 진단 회식 초대장." />
    <link rel="icon" href="/vote/invitation-icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/vote/invitation-icon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/vote/apple-touch-icon.png" sizes="180x180" />
    <title>진단 회식 초대장 · 당신의 자리를 비워뒀어요</title>
  </head>
  <body>
    <main class="invitation-app" id="app">
      <header class="app-header"><span class="wordmark">진단 회식<span class="wordmark-dot">.</span></span><span class="header-note">A LITTLE INVITATION</span><button type="button" class="header-back" id="back-button" hidden>← 이전</button></header>
      <div class="stage">
        <section class="screen cover-screen" id="cover-screen" aria-labelledby="cover-title">
          <div class="cover-copy"><p class="eyebrow">오랜만에, 같은 테이블에서.</p><h1 id="cover-title" tabindex="-1">안건은 회식.<br />진짜 이유는,<br /><em>보고 싶어서.</em></h1><p class="body-copy">바쁜 얘기는 잠깐 접어두고,<br />우리 얼굴 보면서 밥 한 번 먹어요.</p></div>
          <button type="button" id="open-invitation" class="envelope-button" aria-label="진단 회식 초대장 열기"><span class="envelope" aria-hidden="true"><span class="letter"><span>YOU ARE INVITED</span><strong>진단 회식</strong><span>2026 · NOVEMBER</span></span><span class="envelope-back"></span><span class="envelope-front"></span><span class="seal">초대</span></span><span class="envelope-label">당신의 자리를 비워뒀어요 <span>↗</span></span></button>
          <p class="small-note">11월 6일까지, 반가운 답장을 기다릴게요.<br /><span>드레스 코드는 없고, 빈속이면 충분합니다.</span></p>
        </section>
        <section class="screen name-screen" id="name-screen" aria-labelledby="name-title" hidden>
          <div class="step-mark" aria-hidden="true">01 <span>TO. YOU</span></div><div><p class="eyebrow">반가워할 준비는 끝났습니다.</p><h2 id="name-title" tabindex="-1">초대장을 받을<br /><em>이름을 알려 주세요.</em></h2><p class="body-copy">입장 심사는 없어요.<br />그냥, 누가 오는지 알고 싶어서요.</p></div>
          <form id="name-form" novalidate><label for="voter-name">성함이 어떻게 되세요?</label><input id="voter-name" type="text" name="name" placeholder="이름 또는 별명" maxlength="24" autocomplete="nickname" enterkeyhint="go" aria-describedby="name-error name-privacy" /><p id="name-error" class="error-text" role="alert" hidden></p><button type="submit" class="button primary">이 이름으로 인사하기 <span aria-hidden="true">→</span></button><p id="name-privacy" class="fine-print">이름과 가능한 날짜는 참여자에게 보여요.</p></form>
          <span class="name-doodle" aria-hidden="true">반가워요!</span>
        </section>
        <section class="screen welcome-screen" id="welcome-screen" aria-labelledby="welcome-title" hidden>
          <div class="welcome-stamp" id="welcome-stamp" aria-hidden="true">명단<br />확인</div><div><p class="eyebrow" id="welcome-name"></p><h2 id="welcome-title" tabindex="-1"></h2><p class="body-copy preserve-lines" id="welcome-message"></p></div><p class="diagnosis-note" id="welcome-note"></p><div class="welcome-actions"><button type="button" id="go-calendar" class="button primary">안 되는 날 표시하기 <span aria-hidden="true">→</span></button><button type="button" id="rename-button" class="text-button">이름 다시 적기</button></div>
        </section>
        <section class="screen calendar-screen" id="calendar-screen" aria-labelledby="calendar-title" hidden>
          <div class="calendar-intro"><p class="eyebrow" id="calendar-guest"></p><h2 id="calendar-title" tabindex="-1">안 되는 날만 X 해주세요.</h2></div>
          <div class="month-row"><strong>2026<span>년</span> 11<span>월</span></strong><div class="view-switch" role="group" aria-label="달력 표시 방식"><button type="button" id="select-view" aria-pressed="true">내 일정</button><button type="button" id="results-view" aria-pressed="false">모인 일정</button></div></div>
          <p id="calendar-instruction" class="calendar-instruction">누르면 불가 X, 다시 누르면 가능. 빈칸은 가능한 날이에요.</p>
          <div class="calendar-paper"><div class="weekdays" aria-hidden="true">{weekdays.map((w,i) => <span class={i===0?'sunday':i===6?'saturday':''}>{w}</span>)}</div><div class="calendar-grid" role="group" aria-label="2026년 11월 일정" aria-describedby="calendar-instruction">{Array.from({length:35},(_,i)=>i<30?<button type="button" class:list={['day',{sunday:i%7===0,saturday:i%7===6}]} data-day={i+1} aria-label={`11월 ${i+1}일 ${weekdays[i%7]}요일`} aria-pressed="false"><span class="day-number">{i+1}</span><span class="day-check" aria-hidden="true">×</span><span class="day-count"></span></button>:<span class="outside-day" aria-hidden="true">{i-29}</span>)}</div></div>
          <div class="countdown" id="countdown-block"><div><span id="countdown-label">회신 마감까지</span><strong id="countdown-clock" role="timer" aria-live="off">—일 —:—:—</strong></div><p id="deadline-label">11. 6 (금) 23:59 · 한국시간</p></div>
          <div class="calendar-meta"><p id="selection-summary" role="status">불가 0일 · 30일 가능</p><button type="button" id="clear-button">X 모두 지우기</button><button type="button" id="refresh-button" hidden>새로고침 ↻</button></div>
          <button type="button" id="save-button" class="button primary" disabled><span id="save-label">전부 가능해요</span><span aria-hidden="true">→</span></button>
          <p id="calendar-status" class="calendar-status" role="status">마감 전에는 언제든 수정할 수 있어요.</p>
        </section>
        <section class="screen done-screen" id="done-screen" aria-labelledby="done-title" hidden>
          <div class="step-mark" aria-hidden="true">✓ <span>RSVP RECEIVED</span></div><div><p class="eyebrow">회신, 잘 받았습니다.</p><h2 id="done-title" tabindex="-1">달력에 표시했어요.<br /><em>이제 만날 일만 남았네요.</em></h2></div>
          <div class="reply-ticket"><div><span>진단 회식 · 참석 가능일</span><span class="ticket-stamp" aria-hidden="true">접수 완료</span></div><h3 id="done-name"></h3><p class="ticket-count"><strong id="done-count">0</strong>일 가능</p><p id="done-dates"></p><p class="ticket-foot">확정된 날짜는 함께 정해요. 이건 우리의 첫 약속.</p></div>
          <p id="best-summary" class="best-summary"></p><div class="done-actions"><button type="button" id="edit-button" class="button primary">내 일정 수정하기 <span aria-hidden="true">↗</span></button><p id="done-deadline" class="fine-print">11월 6일까지, 같은 브라우저에서 수정할 수 있어요.</p><button type="button" id="view-results-button" class="text-button">모인 일정 구경하기</button></div>
        </section>
      </div>
      <footer class="app-footer"><span>좋은 자리는, 좋은 사람으로 채워집니다.</span><span id="step-counter">OPEN ME</span></footer>
      <div class="connection-notice" id="connection-notice" role="alert" hidden><span id="connection-message"></span><button type="button" id="retry-button">다시 연결</button></div>
      <div class="toast" id="toast" role="status" hidden></div>
      <noscript><div class="connection-notice">초대장을 열려면 JavaScript를 켜 주세요.</div></noscript>
    </main>
    <script>import '../scripts/vote';</script>
  </body>
</html>
