---
import Base from '../layouts/Base.astro'; import PostTile from '../components/PostTile.astro'; import { getPosts, categories, categoryLabels } from '../lib/posts';
const posts = await getPosts(); const feature = posts.find(p=>p.data.featured) ?? posts[0]; const rest = posts.filter(p=>p.id !== feature.id);
---
<Base title="LucasJang — 기록과 사진"><section class="intro"><img class="intro-mark" src="/images/lucasjang-logo.png" alt="LucasJang" width="2163" height="727"><h1>Thought into action,<br />action into essence.</h1><div class="filters" aria-label="카테고리 필터">{categories.map(c=><button data-filter={c}>{categoryLabels[c]}</button>)}</div></section><section class="editorial">{feature && <PostTile post={feature} featured />}{rest.map((post)=><PostTile post={post} />)}</section><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]'),tiles=document.querySelectorAll<HTMLElement>('.tile');const applyFilter=(category:string)=>{tiles.forEach(tile=>{tile.hidden=category!=='ALL'&&tile.dataset.category!==category});buttons.forEach(button=>button.toggleAttribute('aria-pressed',button.dataset.filter===category))};buttons.forEach(button=>button.addEventListener('click',()=>applyFilter(button.dataset.filter??'ALL')));applyFilter(new URLSearchParams(location.search).get('category')??'ALL');</script></Base>
