---
import Base from '../layouts/Base.astro'; import PostTile from '../components/PostTile.astro'; import { getPosts, categories, categoryLabels } from '../lib/posts';
const posts = await getPosts(); const feature = posts.find(p=>p.data.featured) ?? posts[0]; const rest = posts.filter(p=>p.id !== feature.id);
---
<Base title="LucasJang — 기록과 사진" bodyClass="home"><section class="home-hero"><div class="home-hero-copy"><h1>Thought into<br />action, action<br />into essence.</h1><p>사진과 기록으로 남기는 생활의 장면.</p></div><figure class="home-hero-visual"><img src="/images/categories/daily.jpg" alt="햇살이 드는 일상의 공간"></figure></section><section class="home-feed"><div class="home-feed-inner"><div class="filters" aria-label="카테고리 필터">{categories.map(c=><button data-filter={c}>{categoryLabels[c]}</button>)}</div><section class="editorial">{feature && <PostTile post={feature} featured />}{rest.map((post)=><PostTile post={post} />)}</section></div></section><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]'),tiles=document.querySelectorAll<HTMLElement>('.tile');const applyFilter=(category:string)=>{tiles.forEach(tile=>{tile.hidden=category!=='ALL'&&tile.dataset.category!==category});buttons.forEach(button=>button.toggleAttribute('aria-pressed',button.dataset.filter===category))};buttons.forEach(button=>button.addEventListener('click',()=>applyFilter(button.dataset.filter??'ALL')));applyFilter(new URLSearchParams(location.search).get('category')??'ALL');</script></Base>
