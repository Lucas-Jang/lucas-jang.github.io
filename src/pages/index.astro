---
import Base from '../layouts/Base.astro'; import PostTile from '../components/PostTile.astro'; import { getPosts, categories, categoryLabels } from '../lib/posts'; import '../styles/brand.css';
const posts = await getPosts(); const feature = posts.find(p=>p.data.featured) ?? posts[0]; const rest = posts.filter(p=>p.id !== feature.id);
---
<Base title="LucasJang — 기록과 사진"><section class="intro"><img class="intro-mark" src="/images/logo-lj.png" alt="LucasJang의 LJ 모노그램" width="196" height="196"><h1>Thought into action,<br /><em>action into essence.</em></h1><div class="filters" aria-label="카테고리 필터">{categories.map(c=><button data-filter={c}>{categoryLabels[c]}</button>)}</div></section><section class="editorial">{feature && <PostTile post={feature} featured />}{rest.map((post)=><PostTile post={post} />)}</section><script>const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]'),tiles=document.querySelectorAll<HTMLElement>('.tile');const applyFilter=(category:string)=>{tiles.forEach(tile=>{tile.hidden=category!=='ALL'&&tile.dataset.category!==category});buttons.forEach(button=>button.toggleAttribute('aria-pressed',button.dataset.filter===category))};buttons.forEach(button=>button.addEventListener('click',()=>applyFilter(button.dataset.filter??'ALL')));applyFilter(new URLSearchParams(location.search).get('category')??'ALL');</script></Base>
