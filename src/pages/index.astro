---
import Base from '../layouts/Base.astro'; import PostTile from '../components/PostTile.astro'; import { getPosts } from '../lib/posts';
const posts = await getPosts(); const feature = posts.find(p=>p.data.featured) ?? posts[0]; const rest = posts.filter(p=>p.id !== feature.id);
---
<Base title="LucasJang — 기록과 사진" bodyClass="home"><section class="home-hero"><figure class="home-hero-visual"><img src="/images/home-lucasjang.jpg" alt="산 능선을 바라보는 Lucas Jang"></figure><div class="home-hero-copy"><h1>Thought into<br />action, action<br />into essence.</h1><p>생각을 행동으로, 행동을 본질로</p></div></section><section class="home-feed"><div class="home-feed-inner"><section class="editorial">{feature && <PostTile post={feature} featured />}{rest.map((post)=><PostTile post={post} />)}</section></div></section><script>const tiles=document.querySelectorAll<HTMLElement>('.tile'),hero=document.querySelector('.home-hero'),category=new URLSearchParams(location.search).get('category')??'ALL';tiles.forEach(tile=>{tile.hidden=category!=='ALL'&&tile.dataset.category!==category});hero?.toggleAttribute('hidden',category!=='ALL');</script></Base>
