---
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { path: undefined } }] : [];
}
const width = 320;
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Training Journal 모바일 검수</title></head><body><h1>{width}px 모바일 검수</h1><iframe title="모바일 수련 기록" src="/training-preview/#full" width={width} height="1500"></iframe><h2>최소 기록과 긴 콘텐츠</h2><iframe title="모바일 경계 조건" src="/training-preview/#minimal" width={width} height="1500"></iframe></body></html>
<style>body{margin:0;padding:24px;background:#f2f4f5;font-family:system-ui;}h1{font-size:16px;margin:0 0 20px;}iframe{display:block;border:1px solid #9db4c0;background:#dfe9ed;}</style>
