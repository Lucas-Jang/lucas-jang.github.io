---
import Base from '../layouts/Base.astro'; import {getPosts, categoryLabel} from '../lib/posts'; const posts=await getPosts(); const years=Array.from(new Set(posts.map((post)=>post.data.date.getFullYear()))).sort((a,b)=>b-a);
---
<Base title="아카이브 — LucasJang"><section class="archive"><h1>아카이브</h1>{years.map((year)=><section><h2>{year}</h2>{posts.filter((post)=>post.data.date.getFullYear()===year).map((post)=><a href={`/posts/${post.id}/`}><time>{post.data.date.toLocaleDateString('ko-KR',{month:'short',day:'numeric'})}</time><span>{post.data.title}</span><em>{categoryLabel(post.data.category)}</em></a>)}</section>)}</section></Base>
